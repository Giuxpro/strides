{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm*)",
      "Bash(npx turbo*)",
      "Bash(expo*)",
      "Bash(supabase*)",
      "Bash(git init)",
      "Bash(git commit*)",
      "Bash(git tag*)"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/scripts/update-stride-memory.js\""
          }
        ]
      }
    ]
  }
}
